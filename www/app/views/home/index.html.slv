<section class="wrap hero">
  <div class="hero-top">
    <h1>Events on disk, in&nbsp;order.</h1>
    <div>
      <p class="lede">
        es is an event-streaming broker in one Rust binary: topics, partitions, consumer groups and Raft replication.
        A produce call returns its offsets only once the records are fsynced, and it still moves millions of records a second.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="<%= docs_demo_path() %>">Run the quickstart</a>
        <a class="btn btn-secondary" href="<%= docs_path() %>">Read the docs</a>
      </div>
    </div>
  </div>

  <figure class="log" data-log aria-label="Records being appended to three partitions of the topic orders">
    <div class="log-head">
      <span>Topic <strong>orders</strong>, 3 partitions</span>
      <span class="log-legend" aria-hidden="true">
        <span><i class="k-pending"></i>Written</span>
        <span><i class="k-durable"></i>Durable, acknowledged</span>
        <span><i class="k-cursor"></i>Committed by group</span>
      </span>
    </div>
    <div class="lane" data-offset="1204">
      <span class="lane-name">orders/0</span>
      <span class="lane-track"></span>
      <span class="lane-offset">1204</span>
    </div>
    <div class="lane" data-offset="983">
      <span class="lane-name">orders/1</span>
      <span class="lane-track"></span>
      <span class="lane-offset">983</span>
    </div>
    <div class="lane" data-offset="1117">
      <span class="lane-name">orders/2</span>
      <span class="lane-track"></span>
      <span class="lane-offset">1117</span>
    </div>
    <figcaption class="log-foot">
      <span>Group <strong>billing</strong> has committed <b data-committed>1190</b> on orders/0.</span>
      <span>Each square is one record; the number is the next offset.</span>
    </figcaption>
  </figure>
</section>

<section class="wrap band" aria-labelledby="spec-title">
  <div class="band-head">
    <h2 id="spec-title">What ships in the binary</h2>
    <p>No ZooKeeper, no JVM, no client library to install. One process per node, a CLI, and an HTTP API you can call with curl.</p>
  </div>
  <div class="spec">
    <div class="spec-row">
      <h3>Storage</h3>
      <ul>
        <li><strong>Durable by default.</strong> One write and one fsync per request, shared between concurrent requests.</li>
        <li>CRC-checked segment files with a sparse index.</li>
        <li>Retention by age or size, and key compaction with tombstones.</li>
        <li>Crash recovery that trims a torn tail and never touches newer segments.</li>
        <li>Tiered storage: expired segments move to a cold directory instead of being deleted.</li>
      </ul>
    </div>
    <div class="spec-row">
      <h3>Replication</h3>
      <ul>
        <li><strong>Raft per partition:</strong> leader election and batched log replication.</li>
        <li>Late or rebuilt replicas catch up by streaming the leader's records.</li>
        <li>The leader assigns offsets and timestamps, so replicas hold identical records.</li>
        <li>Peers prove a shared secret without sending it; every frame is authenticated.</li>
      </ul>
    </div>
    <div class="spec-row">
      <h3>Access control</h3>
      <ul>
        <li>API keys with read, write and admin grants by topic prefix.</li>
        <li>Produce and consume byte-rate quotas per key.</li>
        <li>Consumer groups and producer ids belong to the key that created them.</li>
        <li>TLS on both the HTTP and the binary listener.</li>
      </ul>
    </div>
    <div class="spec-row">
      <h3>Protocols</h3>
      <ul>
        <li>HTTP and JSON for everything, with base64 for binary values.</li>
        <li>A binary protocol with pipelining and gzip for the hot path.</li>
        <li>Idempotent producers: retried records are written once.</li>
        <li>A schema registry with backward-compatibility checks.</li>
      </ul>
    </div>
    <div class="spec-row">
      <h3>Operations</h3>
      <ul>
        <li>Consumer groups with sticky rebalancing and heartbeats.</li>
        <li>Prometheus metrics, scoped to what the caller's key can read.</li>
        <li>Offline dump and restore that validates an archive before replacing anything.</li>
        <li>Graceful shutdown that drains connections and flushes state.</li>
      </ul>
    </div>
  </div>
</section>

<section class="wrap band" aria-labelledby="perf-title">
  <div class="band-head">
    <h2 id="perf-title">Throughput with fsync on</h2>
    <p>Every number below is measured with the default durability: nothing is acknowledged before it is on disk.</p>
  </div>
  <div class="bars">
    <div class="bar-row">
      <div class="bar-label">Binary produce<small>8 connections, batches of 500</small></div>
      <div class="bar" aria-hidden="true"><span style="width: 100%"></span></div>
      <div class="bar-value">4.6M rec/s</div>
    </div>
    <div class="bar-row">
      <div class="bar-label">HTTP and JSON produce<small>8 clients, batches of 500</small></div>
      <div class="bar" aria-hidden="true"><span style="width: 80%"></span></div>
      <div class="bar-value">3.7M rec/s</div>
    </div>
    <div class="bar-row">
      <div class="bar-label">Binary consume<small>1 connection, 4 MiB fetches</small></div>
      <div class="bar" aria-hidden="true"><span style="width: 65%"></span></div>
      <div class="bar-value">3.0M rec/s</div>
    </div>
    <div class="bar-row">
      <div class="bar-label">Raft partition<small>4 connections, batches of 100</small></div>
      <div class="bar" aria-hidden="true"><span style="width: 22%"></span></div>
      <div class="bar-value">1.0M rec/s</div>
    </div>
    <div class="bar-row">
      <div class="bar-label">Small pipelined writes<small>64 requests in flight, 10 records each</small></div>
      <div class="bar" aria-hidden="true"><span style="width: 2.6%"></span></div>
      <div class="bar-value">118k rec/s</div>
    </div>
  </div>
  <p class="bars-note">
    256-byte records over loopback, release build, on a 32-core server with NVMe storage; the Raft row is a single-node group.
    Batch size matters most: small requests pay for their own fsync.
    The bench is <code>crates/es-broker/tests/bench.rs</code>; <a href="<%= docs_storage_path() %>#throughput">read the method and run it on your hardware</a>.
  </p>
</section>

<section class="wrap band" aria-labelledby="start-title">
  <div class="band-head">
    <h2 id="start-title">Running in three commands</h2>
    <p>Build the workspace, start a broker on localhost, then write and read a few records with the CLI.</p>
  </div>
  <ol class="quick">
    <li>
      <h3>Build</h3>
      <p>Needs a Rust toolchain. Produces <code>es-broker</code>, <code>es</code> and <code>es-tools</code>.</p>
      <figure class="code"><figcaption><span>shell</span></figcaption><pre>cargo build --release</pre></figure>
    </li>
    <li>
      <h3>Start a broker</h3>
      <p>Data goes to <code>./data</code>. Auth is off, which the broker only allows on loopback.</p>
      <figure class="code"><figcaption><span>shell</span></figcaption><pre>./target/release/es-broker \
  --data-dir ./data \
  --bind 127.0.0.1:9000</pre></figure>
    </li>
    <li>
      <h3>Produce and consume</h3>
      <p>Create a topic, write a record, read it back from offset 0.</p>
      <figure class="code"><figcaption><span>shell</span></figcaption><pre>export PATH="$PWD/target/release:$PATH"
export ES_BROKER=http://127.0.0.1:9000
es topic create --name orders --partitions 2
es produce --topic orders --key k1 --value hello
es consume --topic orders --partition 0 --offset 0</pre></figure>
    </li>
  </ol>
  <p class="mt-8"><a class="btn btn-secondary" href="<%= docs_demo_path() %>">Walk through the full quickstart</a></p>
</section>

<script>
(function () {
  function start() {
    var root = document.querySelector('[data-log]');
    if (!root || root.dataset.running) return;
    root.dataset.running = '1';
    var MAX = 72;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var committedOut = root.querySelector('[data-committed]');
    var lanes = Array.prototype.map.call(root.querySelectorAll('.lane'), function (lane) {
      return {
        track: lane.querySelector('.lane-track'),
        out: lane.querySelector('.lane-offset'),
        offset: parseInt(lane.dataset.offset, 10)
      };
    });
    function cell(pending) {
      var c = document.createElement('i');
      c.className = pending ? 'cell pending enter' : 'cell';
      return c;
    }
    lanes.forEach(function (l) {
      for (var k = 0; k < MAX - 10; k++) l.track.appendChild(cell(false));
    });
    var group = { lane: lanes[0], committed: lanes[0].offset - 14, marked: null };
    function markCommitted() {
      var l = group.lane;
      var idx = l.track.children.length - (l.offset - group.committed);
      if (group.marked) group.marked.classList.remove('cursor');
      group.marked = l.track.children[idx] || null;
      if (group.marked) group.marked.classList.add('cursor');
      committedOut.textContent = group.committed;
    }
    markCommitted();
    if (reduce) return;

    function append(l) {
      var c = cell(true);
      l.track.appendChild(c);
      l.offset += 1;
      l.out.textContent = l.offset;
      if (l.track.children.length > MAX) l.track.removeChild(l.track.firstElementChild);
      setTimeout(function () { c.classList.remove('pending'); }, 260 + Math.random() * 260);
    }
    function schedule(l) {
      setTimeout(function () {
        if (!root.isConnected) return;
        var burst = Math.random() < 0.18 ? 3 : 1;
        for (var b = 0; b < burst; b++) append(l);
        if (l === group.lane) markCommitted();
        schedule(l);
      }, 180 + Math.random() * 520);
    }
    lanes.forEach(schedule);
    (function commitLoop() {
      setTimeout(function () {
        if (!root.isConnected) return;
        group.committed = Math.max(group.committed, group.lane.offset - 4 - Math.floor(Math.random() * 8));
        markCommitted();
        commitLoop();
      }, 1400);
    })();
  }
  if (document.readyState !== 'loading') start();
  document.addEventListener('DOMContentLoaded', start);
  document.addEventListener('soli:load', start);
})();
</script>
