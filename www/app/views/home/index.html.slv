<style>
  .reveal { opacity: 0; transform: translateY(10px); animation: reveal .9s cubic-bezier(.22,.61,.36,1) forwards; }
  .reveal.d1 { animation-delay: 0.06s; }
  .reveal.d2 { animation-delay: 0.14s; }
  .reveal.d3 { animation-delay: 0.22s; }
  .reveal.d4 { animation-delay: 0.30s; }
  .reveal.d5 { animation-delay: 0.38s; }
  @keyframes reveal { to { opacity: 1; transform: translateY(0); } }

  .pulse-dot {
    box-shadow: 0 0 0 0 rgba(52,211,153,0.55);
    animation: pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(52,211,153,0.55); }
    70%  { box-shadow: 0 0 0 12px rgba(52,211,153,0); }
    100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); }
  }

  .blink::after {
    content: "▌"; display: inline-block; margin-left: 2px;
    color: rgb(52,211,153); animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .glyph-orbit {
    position: absolute; inset: -40px; border-radius: 999px;
    background: conic-gradient(from 180deg, rgba(99,102,241,0.35), rgba(217,70,239,0.25), rgba(99,102,241,0.35));
    filter: blur(28px); opacity: 0.55; animation: spin 14s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<!-- ATMOSPHERE -->
<div class="fixed inset-0 pointer-events-none -z-10">
  <div class="absolute inset-0 bg-slate-950"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_55%_at_75%_-10%,rgba(99,102,241,0.22),transparent_55%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_10%_110%,rgba(217,70,239,0.13),transparent_60%)]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.022)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.022)_1px,transparent_1px)] bg-[size:80px_80px]"></div>
  <div class="absolute inset-0 grain opacity-[0.4] mix-blend-screen"></div>
</div>

<!-- TOP BAR -->
<header class="sticky top-0 z-40 backdrop-blur-md border-b border-white/[0.06] bg-slate-950/65">
  <div class="max-w-[1340px] mx-auto px-6 lg:px-10 h-14 flex items-center gap-5">
    <a href="<%= root_path() %>" class="flex items-center gap-2.5 group">
      <span class="pulse-dot inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="font-display text-[15px] tracking-tight text-white">es<span class="font-display italic font-light text-slate-400">.docs</span></span>
    </a>
    <span class="hidden md:inline-block h-4 w-px bg-white/10"></span>
    <span class="hidden md:inline-block font-mono text-[11px] tracking-[0.16em] text-slate-400/80 uppercase">basic event streaming · rust</span>
    <div class="ml-auto flex items-center gap-5">
      <span class="hidden md:inline-block font-mono text-[10px] tracking-[0.15em] text-slate-500 uppercase">v0.1.0</span>
      <a href="<%= docs_path() %>" class="text-[12px] font-mono tracking-[0.15em] uppercase text-slate-300 hover:text-white transition">Docs →</a>
    </div>
  </div>
</header>

<main class="max-w-[1340px] mx-auto px-6 lg:px-10">

  <!-- HERO -->
  <section class="pt-16 lg:pt-24 pb-12 lg:pb-20 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">

    <div class="lg:col-span-7 relative">
      <div class="reveal flex items-center gap-3 mb-6">
        <span class="font-mono text-[10px] tracking-[0.28em] uppercase text-indigo-300/90">§ 00 · Manifest</span>
        <span class="h-px flex-1 bg-gradient-to-r from-indigo-400/40 via-white/10 to-transparent"></span>
      </div>

      <h1 class="reveal d1 font-display font-light text-[64px] sm:text-[78px] lg:text-[104px] leading-[0.92] tracking-[-0.035em] text-white">
        Basic
        <span class="font-display italic font-light text-indigo-200/90 [font-feature-settings:'ss01']">event streaming.</span>
        <br>
        <span class="text-slate-200">Written from</span>
        <span class="font-display italic font-light text-indigo-200/90">scratch</span>
        <span class="text-slate-200">in Rust.</span>
      </h1>

      <p class="reveal d2 mt-9 max-w-[58ch] text-[18px] leading-[1.7] text-slate-300 font-light">
        A small Kafka-shaped event log: one binary for the broker, one for the CLI, append-only segment files on disk.
        <strong class="font-semibold text-white">No Kafka libraries, no ZooKeeper, no broker dependency.</strong>
        111k records/second with 4 partitions and concurrent binary producers.
      </p>

      <div class="reveal d3 mt-10 flex flex-wrap items-center gap-3">
        <a href="<%= docs_demo_path() %>" class="group inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-slate-950 font-medium text-[14px] tracking-tight hover:bg-indigo-200 transition">
          Run the demo
          <span class="font-mono text-[12px] text-slate-500 group-hover:text-indigo-700 transition">→</span>
        </a>
        <a href="<%= docs_path() %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full ring-1 ring-white/15 bg-white/[0.03] text-slate-100 hover:bg-white/[0.06] hover:ring-white/25 text-[14px] tracking-tight transition">
          Read the docs
        </a>
        <a href="<%= docs_storage_path() %>" class="hidden sm:inline-flex items-center gap-2 px-3 py-2.5 font-mono text-[12px] tracking-[0.05em] text-slate-400 hover:text-white transition">
          /storage-format
        </a>
      </div>
    </div>

    <!-- HERO TERMINAL -->
    <div class="lg:col-span-5 reveal d2 relative">
      <div class="absolute -inset-6 bg-[radial-gradient(ellipse_60%_60%_at_50%_50%,rgba(99,102,241,0.18),transparent_70%)] -z-10"></div>

      <div class="rounded-2xl overflow-hidden shadow-[0_28px_80px_-32px_rgba(99,102,241,0.55)] ring-1 ring-white/[0.08] bg-slate-950/70 backdrop-blur-sm">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/[0.07] bg-slate-900/60">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-400/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-amber-300/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></span>
          <span class="ml-3 font-mono text-[11px] text-slate-500 tracking-wide">~/workspace/es</span>
          <span class="ml-auto font-mono text-[10px] tracking-[0.16em] uppercase text-indigo-300/70">live</span>
        </div>
        <div class="p-5 font-mono text-[12.5px] leading-[1.75]">
          <p><span class="text-slate-500">$</span> <span class="text-slate-200">make demo</span></p>
          <p class="text-slate-500">== reset data dir</p>
          <p class="text-slate-500">== ensure release build</p>
          <p class="text-slate-500">== start broker on http://127.0.0.1:9876</p>
          <p class="text-slate-500">== create topic 'orders' with 2 partitions</p>
          <p>created topic <span class="text-amber-200">'orders'</span> with <span class="text-teal-300">2</span> partition(s)</p>
          <p class="text-slate-500">== produce 200 records</p>
          <p class="text-slate-500">== describe topic (segment rolls visible)</p>
          <p>topic <span class="text-amber-200">orders</span></p>
          <p>  partition <span class="text-teal-300">0</span>  start=<span class="text-teal-300">0</span>  end=<span class="text-teal-300">100</span>  segments=<span class="text-indigo-200">4</span></p>
          <p>  partition <span class="text-teal-300">1</span>  start=<span class="text-teal-300">0</span>  end=<span class="text-teal-300">100</span>  segments=<span class="text-indigo-200">4</span></p>
          <p class="text-slate-500">== restart broker and resume</p>
          <p>topic <span class="text-amber-200">orders</span></p>
          <p>  partition <span class="text-teal-300">0</span> -> offset <span class="text-teal-300">5</span></p>
          <p class="mt-3 inline-flex items-center gap-2">
            <span class="px-2 py-0.5 rounded text-[10px] tracking-[0.18em] uppercase bg-emerald-500/15 text-emerald-300 ring-1 ring-emerald-400/30">ok</span>
            <span class="text-emerald-300 blink">DEMO OK</span>
          </p>
        </div>
      </div>

      <p class="mt-4 font-mono text-[10.5px] tracking-[0.15em] uppercase text-slate-500">/scripts/demo.sh · reproducible</p>
    </div>
  </section>

      <!-- What's actually shipped — card grid by category -->
      <section class="reveal d4 mt-14">
        <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-emerald-300/80 mb-6">What's actually shipped</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

          <!-- Durability -->
          <div class="rounded-xl ring-1 ring-emerald-400/15 bg-emerald-400/[0.03] p-5 hover:bg-emerald-400/[0.05] transition">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="flex items-center justify-center w-6 h-6 rounded-md bg-emerald-400/15 text-emerald-300 text-[13px]">◆</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-emerald-400/60">Durability</span>
            </div>
            <ul class="space-y-2 text-[12.5px] text-emerald-200/85 leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-emerald-500/50 mt-0.5">—</span>CRC-framed segmented log</li>
              <li class="flex items-start gap-2"><span class="text-emerald-500/50 mt-0.5">—</span>Crash recovery (torn-write detection + truncation)</li>
              <li class="flex items-start gap-2"><span class="text-emerald-500/50 mt-0.5">—</span>Configurable fsync policy</li>
            </ul>
          </div>

          <!-- Retention -->
          <div class="rounded-xl ring-1 ring-teal-400/15 bg-teal-400/[0.03] p-5 hover:bg-teal-400/[0.05] transition">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="flex items-center justify-center w-6 h-6 rounded-md bg-teal-400/15 text-teal-300 text-[13px]">◈</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-teal-400/60">Retention</span>
            </div>
            <ul class="space-y-2 text-[12.5px] text-teal-200/85 leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-teal-500/50 mt-0.5">—</span>Time-based &amp; size-based retention</li>
              <li class="flex items-start gap-2"><span class="text-teal-500/50 mt-0.5">—</span>Log compaction with tombstone aging</li>
              <li class="flex items-start gap-2"><span class="text-teal-500/50 mt-0.5">—</span>Tiered storage (cold offload on retention)</li>
            </ul>
          </div>

          <!-- Security -->
          <div class="rounded-xl ring-1 ring-amber-400/15 bg-amber-400/[0.03] p-5 hover:bg-amber-400/[0.05] transition">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="flex items-center justify-center w-6 h-6 rounded-md bg-amber-400/15 text-amber-300 text-[13px]">⬡</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-amber-400/60">Security</span>
            </div>
            <ul class="space-y-2 text-[12.5px] text-amber-200/85 leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-amber-500/50 mt-0.5">—</span>TLS (rustls)</li>
              <li class="flex items-start gap-2"><span class="text-amber-500/50 mt-0.5">—</span>Bearer-token auth + ACLs</li>
              <li class="flex items-start gap-2"><span class="text-amber-500/50 mt-0.5">—</span>Per-key rate limiting</li>
              <li class="flex items-start gap-2"><span class="text-amber-500/50 mt-0.5">—</span>CORS · body size limits · panic recovery</li>
            </ul>
          </div>

          <!-- Consensus -->
          <div class="rounded-xl ring-1 ring-indigo-400/15 bg-indigo-400/[0.03] p-5 hover:bg-indigo-400/[0.05] transition">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="flex items-center justify-center w-6 h-6 rounded-md bg-indigo-400/15 text-indigo-300 text-[13px]">⬢</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-indigo-400/60">Consensus</span>
            </div>
            <ul class="space-y-2 text-[12.5px] text-indigo-200/85 leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-indigo-500/50 mt-0.5">—</span>Raft: leader election, log replication, snapshots</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500/50 mt-0.5">—</span>InstallSnapshot RPC</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500/50 mt-0.5">—</span>Raft-backed partition log + TCP transport</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500/50 mt-0.5">—</span>Membership changes (config log entries)</li>
            </ul>
          </div>

          <!-- Protocol -->
          <div class="rounded-xl ring-1 ring-purple-400/15 bg-purple-400/[0.03] p-5 hover:bg-purple-400/[0.05] transition">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="flex items-center justify-center w-6 h-6 rounded-md bg-purple-400/15 text-purple-300 text-[13px]">◇</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-purple-400/60">Protocol</span>
            </div>
            <ul class="space-y-2 text-[12.5px] text-purple-200/85 leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-purple-500/50 mt-0.5">—</span>HTTP/JSON API + binary protocol</li>
              <li class="flex items-start gap-2"><span class="text-purple-500/50 mt-0.5">—</span>Binary: gzip handshake, pipelining</li>
              <li class="flex items-start gap-2"><span class="text-purple-500/50 mt-0.5">—</span>Idempotent producer (replay dedup)</li>
              <li class="flex items-start gap-2"><span class="text-purple-500/50 mt-0.5">—</span>Schema registry (JSON Schema, compat checks)</li>
            </ul>
          </div>

          <!-- Operations -->
          <div class="rounded-xl ring-1 ring-rose-400/15 bg-rose-400/[0.03] p-5 hover:bg-rose-400/[0.05] transition">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="flex items-center justify-center w-6 h-6 rounded-md bg-rose-400/15 text-rose-300 text-[13px]">○</span>
              <span class="font-mono text-[10px] tracking-[0.18em] uppercase text-rose-400/60">Operations</span>
            </div>
            <ul class="space-y-2 text-[12.5px] text-rose-200/85 leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-rose-500/50 mt-0.5">—</span>/healthz + /readyz + /metrics (14 series)</li>
              <li class="flex items-start gap-2"><span class="text-rose-500/50 mt-0.5">—</span>Consumer groups + sticky coordinator</li>
              <li class="flex items-start gap-2"><span class="text-rose-500/50 mt-0.5">—</span>SIGTERM graceful shutdown + drain</li>
              <li class="flex items-start gap-2"><span class="text-rose-500/50 mt-0.5">—</span>CI: fmt, clippy, test, cargo-deny</li>
            </ul>
          </div>

        </div>
      </section>

  <div class="rule-x my-6 lg:my-12"></div>

  <!-- STATS STRIP -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/[0.05] rounded-2xl overflow-hidden mb-14 lg:mb-20">
    <div class="bg-slate-950/60 p-6">
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-indigo-300/80 mb-2">Lang</p>
      <p class="font-display font-light text-[34px] tracking-tight text-white">Rust <span class="italic text-slate-400 font-light">1.95</span></p>
    </div>
    <div class="bg-slate-950/60 p-6">
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-indigo-300/80 mb-2">Crates</p>
      <p class="font-display font-light text-[34px] tracking-tight text-white">3 <span class="italic text-slate-400 font-light text-[24px]">/ workspace</span></p>
    </div>
    <div class="bg-slate-950/60 p-6">
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-indigo-300/80 mb-2">Throughput</p>
      <p class="font-display font-light text-[34px] tracking-tight text-white">111k <span class="italic text-emerald-300/80 font-light text-[24px]">rec/s</span></p>
    </div>
    <div class="bg-slate-950/60 p-6">
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-indigo-300/80 mb-2">Tests</p>
      <p class="font-display font-light text-[34px] tracking-tight text-white">71 <span class="italic text-emerald-300/80 font-light text-[24px]">passing</span></p>
    </div>
  </section>

  <!-- FEATURE BLOCKS -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 mb-14 lg:mb-24">
    <div class="lg:col-span-4">
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-indigo-300/85 mb-3">§ 01 · The shape</p>
      <h2 class="font-display font-light text-[40px] leading-[1.05] tracking-[-0.025em] text-white">
        Topics, partitions,<br>
        <span class="italic text-indigo-200/90 font-light">offsets you commit</span>
        — that's it.
      </h2>
      <p class="mt-5 text-[15px] leading-[1.75] text-slate-400 font-light">
        The mental model is intentionally the same as Kafka's, minus the operational footprint. If you've used a Kafka client you already know how to use <span class="text-white">es</span>.
      </p>
    </div>
    <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a href="<%= docs_api_path() %>" class="group p-6 rounded-xl bg-white/[0.025] ring-1 ring-white/[0.06] hover:ring-indigo-400/30 hover:bg-white/[0.04] transition">
        <div class="flex items-baseline justify-between mb-3">
          <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-emerald-300/85">P · C</span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-slate-600 group-hover:text-slate-400 transition">→</span>
        </div>
        <p class="font-display text-[22px] tracking-tight text-white mb-1">Produce &amp; consume</p>
        <p class="text-[13.5px] text-slate-400 leading-relaxed">HTTP/JSON. Records carry key, value, timestamp, offset.</p>
      </a>
      <a href="<%= docs_api_path() %>" class="group p-6 rounded-xl bg-white/[0.025] ring-1 ring-white/[0.06] hover:ring-indigo-400/30 hover:bg-white/[0.04] transition">
        <div class="flex items-baseline justify-between mb-3">
          <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-indigo-300/85">topics</span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-slate-600 group-hover:text-slate-400 transition">→</span>
        </div>
        <p class="font-display text-[22px] tracking-tight text-white mb-1">Partitioned, keyed</p>
        <p class="text-[13.5px] text-slate-400 leading-relaxed">Per-topic partitions. FNV-1a key-hash keeps order stable.</p>
      </a>
      <a href="<%= docs_api_path() %>" class="group p-6 rounded-xl bg-white/[0.025] ring-1 ring-white/[0.06] hover:ring-amber-300/30 hover:bg-white/[0.04] transition">
        <div class="flex items-baseline justify-between mb-3">
          <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-amber-300/85">group</span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-slate-600 group-hover:text-slate-400 transition">→</span>
        </div>
        <p class="font-display text-[22px] tracking-tight text-white mb-1">Consumer groups</p>
        <p class="text-[13.5px] text-slate-400 leading-relaxed">Explicit commits. Atomic-rename JSON. Restart-safe.</p>
      </a>
      <a href="<%= docs_storage_path() %>" class="group p-6 rounded-xl bg-white/[0.025] ring-1 ring-white/[0.06] hover:ring-rose-300/30 hover:bg-white/[0.04] transition">
        <div class="flex items-baseline justify-between mb-3">
          <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-rose-300/85">safe</span>
          <span class="font-mono text-[10px] tracking-[0.2em] text-slate-600 group-hover:text-slate-400 transition">→</span>
        </div>
        <p class="font-display text-[22px] tracking-tight text-white mb-1">CRC + truncate</p>
        <p class="text-[13.5px] text-slate-400 leading-relaxed">A torn write at the tail is found and trimmed on the next boot.</p>
      </a>
    </div>
  </section>

  <div class="rule-x my-6 lg:my-12"></div>

  <!-- DESIGN PRINCIPLES -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 mb-16 lg:mb-24">
    <div class="lg:col-span-4">
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-indigo-300/85 mb-3">§ 02 · The spirit</p>
      <h2 class="font-display font-light text-[40px] leading-[1.05] tracking-[-0.025em] text-white">
        A study in
        <span class="italic text-indigo-200/90 font-light">restraint.</span>
      </h2>
      <p class="mt-5 text-[15px] leading-[1.75] text-slate-400 font-light">
        Every line is small enough to read in an afternoon. The on-disk format is one short page. There are no abstractions for things <span class="italic text-slate-200">es</span> does not do.
      </p>
    </div>
    <div class="lg:col-span-8 space-y-3">
      <div class="grid grid-cols-[60px_1fr_auto] items-center gap-5 py-4 border-b border-white/[0.06]">
        <p class="font-display italic text-indigo-200/80 text-[20px]">i.</p>
        <p class="text-slate-200 text-[16px] font-light leading-snug">If a Kafka concept doesn't fit on one page, we don't ship it.</p>
        <p class="font-mono text-[10.5px] tracking-[0.16em] uppercase text-slate-500">scope</p>
      </div>
      <div class="grid grid-cols-[60px_1fr_auto] items-center gap-5 py-4 border-b border-white/[0.06]">
        <p class="font-display italic text-indigo-200/80 text-[20px]">ii.</p>
        <p class="text-slate-200 text-[16px] font-light leading-snug">Crash safety is a feature; sophisticated I/O patterns are not.</p>
        <p class="font-mono text-[10.5px] tracking-[0.16em] uppercase text-slate-500">discipline</p>
      </div>
      <div class="grid grid-cols-[60px_1fr_auto] items-center gap-5 py-4 border-b border-white/[0.06]">
        <p class="font-display italic text-indigo-200/80 text-[20px]">iii.</p>
        <p class="text-slate-200 text-[16px] font-light leading-snug">Index files are derived state. The log is the source of truth.</p>
        <p class="font-mono text-[10.5px] tracking-[0.16em] uppercase text-slate-500">durability</p>
      </div>
      <div class="grid grid-cols-[60px_1fr_auto] items-center gap-5 py-4">
        <p class="font-display italic text-indigo-200/80 text-[20px]">iv.</p>
        <p class="text-slate-200 text-[16px] font-light leading-snug">The CLI is a thin <span class="font-mono text-indigo-200 text-[14px]">reqwest</span> wrapper. The wire is the contract.</p>
        <p class="font-mono text-[10.5px] tracking-[0.16em] uppercase text-slate-500">contract</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mb-20 lg:mb-32">
    <div class="relative rounded-3xl overflow-hidden ring-1 ring-white/[0.07] bg-gradient-to-br from-indigo-500/[0.10] via-slate-900/40 to-purple-500/[0.08] p-10 lg:p-14">
      <div class="absolute inset-0 grain opacity-30 mix-blend-screen pointer-events-none"></div>
      <div class="absolute -top-12 -right-12 w-72 h-72 rounded-full bg-indigo-500/15 blur-3xl pointer-events-none"></div>

      <p class="font-mono text-[10px] tracking-[0.28em] uppercase text-indigo-300/85 mb-5">§ 03 · Go</p>
      <h2 class="font-display font-light text-[46px] sm:text-[60px] lg:text-[78px] leading-[0.95] tracking-[-0.03em] text-white max-w-[18ch]">
        Read the docs.
        <span class="italic text-indigo-200/90 font-light">Run the demo.</span>
        Inspect the code.
      </h2>
      <p class="mt-7 max-w-[58ch] text-[16.5px] leading-[1.7] text-slate-300 font-light">
        Three crates, ~8k lines of broker code + tests. <code>make demo</code> exercises produce, consume, segment rolls, retention, compaction, group resume, and restart in one command. 111k records/second with 4 partitions and concurrent binary producers. The 71-test suite covers CRC recovery, Raft election + replication + snapshots, sticky rebalance, idempotent dedup, torn-write recovery, and byte-exact binary roundtrip.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="<%= docs_path() %>" class="group inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-slate-950 font-medium text-[14px] tracking-tight hover:bg-indigo-200 transition">
          Read the docs
          <span class="font-mono text-[12px] text-slate-500 group-hover:text-indigo-700 transition">→</span>
        </a>
        <a href="<%= docs_demo_path() %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full ring-1 ring-white/15 bg-white/[0.03] text-slate-100 hover:bg-white/[0.06] hover:ring-white/25 text-[14px] tracking-tight transition">
          Run the demo
        </a>
      </div>
    </div>
  </section>

</main>

<footer class="border-t border-white/[0.06]">
  <div class="max-w-[1340px] mx-auto px-6 lg:px-10 py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="pulse-dot inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="font-display text-[16px] tracking-tight text-white">es<span class="font-display italic font-light text-slate-400">.docs</span></span>
      </div>
      <p class="mt-3 text-[13px] text-slate-500 leading-relaxed max-w-[40ch]">A learning project hardened for production. Read the source, build the demo, then run it yourself.</p>
    </div>
    <div>
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-slate-500 mb-3">Sections</p>
      <ul class="space-y-1.5 text-[13.5px]">
        <li><a href="<%= docs_path() %>" class="text-slate-300 hover:text-white transition">§01 · Overview</a></li>
        <li><a href="<%= docs_demo_path() %>" class="text-slate-300 hover:text-white transition">§02 · Quickstart</a></li>
        <li><a href="<%= docs_api_path() %>" class="text-slate-300 hover:text-white transition">§03 · HTTP API</a></li>
        <li><a href="<%= docs_cli_path() %>" class="text-slate-300 hover:text-white transition">§04 · CLI</a></li>
        <li><a href="<%= docs_storage_path() %>" class="text-slate-300 hover:text-white transition">§05 · Storage</a></li>
      </ul>
    </div>
    <div>
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-slate-500 mb-3">Built with</p>
      <p class="text-[13.5px] text-slate-300">A workspace of <span class="font-mono text-indigo-200">3 Rust crates</span>, served through a small <a href="https://soli.solisoft.net" class="underline decoration-slate-600 hover:decoration-white text-slate-200">Soli</a> app.</p>
      <p class="mt-4 font-mono text-[10.5px] tracking-[0.15em] uppercase text-slate-600">v0.1.0 · rust 1.95</p>
    </div>
  </div>
</footer>
