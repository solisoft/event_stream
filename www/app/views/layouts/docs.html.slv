<!DOCTYPE html>
<html lang="en">
<head>
  <%- partial("layouts/head", {"title": title}) %>
</head>
<body>
  <%- partial("layouts/header", {"current": site_nav_for(section)}) %>
  <% neighbors = doc_neighbors(section, [
       ["overview", "Overview", docs_path()],
       ["demo", "Quickstart", docs_demo_path()],
       ["api", "HTTP and binary API", docs_api_path()],
       ["cli", "CLI and broker flags", docs_cli_path()],
       ["storage", "How storage works", docs_storage_path()],
       ["cluster", "Clustering with Raft", docs_cluster_path()],
       ["tools", "Backup and restore", docs_tools_path()]
     ]) %>

  <div class="wrap docs">
    <nav class="docs-nav" aria-label="Documentation">
      <details x-data x-init="$el.open = window.matchMedia('(min-width: 1000px)').matches">
        <summary>Documentation menu</summary>
        <div>
          <h2>Get started</h2>
          <a href="<%= docs_path() %>" <% if section == "overview" %>aria-current="page"<% end %>>Overview</a>
          <a href="<%= docs_demo_path() %>" <% if section == "demo" %>aria-current="page"<% end %>>Quickstart</a>
          <h2>Reference</h2>
          <a href="<%= docs_api_path() %>" <% if section == "api" %>aria-current="page"<% end %>>HTTP and binary API</a>
          <a href="<%= docs_cli_path() %>" <% if section == "cli" %>aria-current="page"<% end %>>CLI and broker flags</a>
          <h2>How it works</h2>
          <a href="<%= docs_storage_path() %>" <% if section == "storage" %>aria-current="page"<% end %>>How storage works</a>
          <a href="<%= docs_cluster_path() %>" <% if section == "cluster" %>aria-current="page"<% end %>>Clustering with Raft</a>
          <h2>Operations</h2>
          <a href="<%= docs_tools_path() %>" <% if section == "tools" %>aria-current="page"<% end %>>Backup and restore</a>
        </div>
      </details>
    </nav>

    <main id="main" class="prose">
      <article id="article">
        <%= yield %>
      </article>

      <nav class="pager" aria-label="Pagination">
        <% if neighbors["previous"] %>
          <a class="prev" href="<%= neighbors["previous"][2] %>"><small>Previous</small><span><%= neighbors["previous"][1] %></span></a>
        <% end %>
        <% if neighbors["next"] %>
          <a class="next" href="<%= neighbors["next"][2] %>"><small>Next</small><span><%= neighbors["next"][1] %></span></a>
        <% end %>
      </nav>
    </main>

    <aside class="toc" aria-label="On this page">
      <div x-data="{ items: [], current: null }"
           x-init="
             const article = document.getElementById('article');
             const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,60);
             const seen = new Set();
             items = Array.from(article.querySelectorAll('h2')).map((h) => {
               let id = h.id; if (!id) { id = slug(h.textContent); let n = 1; while (seen.has(id)) { id = slug(h.textContent) + '-' + (++n); } h.id = id; }
               seen.add(id);
               return { id, text: h.textContent.trim() };
             });
             const io = new IntersectionObserver((entries) => {
               entries.forEach(e => { if (e.isIntersecting) current = e.target.id; });
             }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });
             article.querySelectorAll('h2').forEach(h => io.observe(h));
           ">
        <h2 x-show="items.length > 0">On this page</h2>
        <template x-for="item in items" :key="item.id">
          <a :href="'#' + item.id" :class="current === item.id ? 'is-current' : ''" x-text="item.text"></a>
        </template>
      </div>
    </aside>
  </div>

  <%- partial("layouts/footer", {}) %>
  <script defer src="<%= public_path("js/alpine.min.js") %>"></script>
</body>
</html>
